# Convex writes the deployment and public URL when you run `bunx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Copy these from the Clerk development instance. Keep the secret key server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set CLERK_JWT_ISSUER_DOMAIN on the Convex deployment to the Clerk Frontend API URL.
# Set WISHLIST_OWNER_EMAIL on the Convex deployment to the owner's verified email.
